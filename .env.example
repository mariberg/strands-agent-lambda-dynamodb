# Copy this file to .env and fill in your values before deploying.
#   cp .env.example .env
# Then load the variables into your shell (in every new terminal):
#   source .env
#
# Each line uses `export` so the values also reach child processes such as
# the AWS CLI and the seed scripts, not just $VAR expansion in your shell.

# AWS CLI profile to use. Remove this line to use your default credentials.
export AWS_PROFILE=default

# A globally unique S3 bucket name (S3 bucket names are unique across all AWS accounts).
# The bucket will be created in the region below.
export S3_BUCKET=your-unique-bucket-name

# AWS region to deploy into (e.g. us-east-1, eu-west-1)
export AWS_REGION=us-east-1

# CloudFormation stack name — change this if you want multiple deployments side by side.
export STACK_NAME=strands-demo

# Environment label (matches the DynamoDB table suffix and the Lambda name).
export ENV=demo

# Function URL from deploy step 5, without the trailing slash.
# Leave empty until you've deployed.
export BASE=
